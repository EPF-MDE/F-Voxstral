# ---- Model / vLLM ----
MODEL_NAME=mistralai/Voxtral-Mini-3B-2507
VLLM_VERSION=v0.10.1.1
# Shared key between app and vLLM (change it on the VM!)
VLLM_API_KEY=change-me
# Optional, only needed for gated models / higher download rate limits
HF_TOKEN=

# ---- Shared GPU settings ----
# Which GPU of the VM to use (see nvidia-smi)
GPU_ID=0
# Fraction of GPU memory vLLM may reserve. Voxtral Mini needs ~9.5 GB (bf16)
# + KV cache. 0.45 on a 24 GB card ~= 10.8 GB. Increase on smaller GPUs.
GPU_MEM_UTIL=0.45
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=8
# Extra vLLM flags, quoted if they contain spaces, e.g. VLLM_EXTRA_ARGS="--dtype half" on T4/V100 (no bf16 support)
VLLM_EXTRA_ARGS=

# ---- Ports (change if another user already uses them on the VM) ----
APP_PORT=8080
APP_BIND=127.0.0.1
VLLM_PORT=8000

# ---- App tuning ----
MAX_CONCURRENT_REQUESTS=4
MAX_QUEUE_PER_SESSION=4
VAD_RMS_THRESHOLD=400
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=500
VAD_MAX_SEGMENT_MS=12000
LOG_LEVEL=INFO
